{
  "parser": "babel-eslint",
  "extends": "standard",
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },
  "env": {
    "browser": true
  },
  "rules": {
    "import/no-unresolved": [
      2
    ],
    "semi": "off",
    "space-before-function-paren": 0
  },
  "globals": {
    "phaser": true,
    "globalUser": false,
    "Analytics": false
  },
  "settings": {
    "import/core-modules": [
      "phaser",
      "pixi",
      "p2",
      "jquery",
      "globalUser",
      "Analytics",
      "getPassedStageIDList",
      "path_prefix"
    ]
  }
}